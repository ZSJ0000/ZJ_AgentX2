{
  "base_url": "http://127.0.0.1:8000/v1",
  "api_key": "",
  "model": "local-model",
  "workspace": "workspace",
  "timeout_seconds": 60,
  "max_rounds": 8,
  "max_depth": 2,
  "enable_shell": false,
  "mcp_servers": [
    {
      "name": "demo",
      "command": "python",
      "args": [
        "path/to/mcp_server.py"
      ],
      "timeout_seconds": 30
    },
    {
      "name": "github",
      "enabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    }
  ],
  "subagents": {
    "researcher": {
      "system_prompt": "Research carefully.",
      "allowed_tools": [
        "http_get"
      ],
      "max_rounds": 6
    }
  },
  "enable_host_tools": false,
  "web": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8765,
    "auth_enabled": true,
    "auth_mode": "text",
    "password": "change-me",
    "pattern": "1,2,3,4"
  }
}
