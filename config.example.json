{
  "base_url": "http://127.0.0.1:8000/v1",
  "api_key": "",
  "model": "local-model",
  "startup_mode": "gui",
  "max_long_cycles": 1000,
  "gui": {
    "enabled": true
  },
  "workspace": "workspace",
  "timeout_seconds": 60,
  "max_rounds": 8,
  "max_depth": 2,
  "enable_shell": false,
  "mcp_servers": [],
  "subagents": {
    "researcher": {
      "system_prompt": "Research carefully.",
      "allowed_tools": [
        "http_get"
      ],
      "max_rounds": 6
    }
  },
  "enable_host_tools": false,
  "web": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8765,
    "auth_enabled": true,
    "auth_mode": "text",
    "password": "change-me",
    "pattern": "1,2,3,4",
    "secret": "change-this-local-secret"
  },
  "stream": true,
  "stream_output": true,
  "subagent_policy": "prefer_when_complex"
